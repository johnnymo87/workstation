# Nix
result
result-*
.direnv/

# Secrets (encrypted files are OK, but not decrypted)
secrets/*.dec.*

# Editor
*.swp
*~
.nvim.lua

# beads has its own .beads/.gitignore that correctly excludes the DB,
# sockets, daemon files, and JSONL exports. We do NOT blanket-ignore
# .beads/ here so that config.yaml and other non-ignored config files
# remain tracked, while data files are kept git-free.

# OpenCode user configuration (managed per-machine)
.opencode/*
!.opencode/skills/
session-ses_*.md

# Worktrees
.worktrees/

# Node / bun tooling run from the repo root or any package dir. Nix never
# vendors these -- the derivations build node_modules from the lockfiles and
# link it in (flake.nix:1816, :267) -- so nothing in the build depends on the
# tree carrying one. The rule exists because `git add -A` does: a stray
# `npx vitest run` at the root left node_modules/.vite/vitest/<hash>/results.json
# staged during workstation-i0rz, and it reached a commit before being caught.
node_modules/

# Python
__pycache__/
*.pyc
*.pyo

# beads tracker (git-free/stealth dolt)
.beads/
