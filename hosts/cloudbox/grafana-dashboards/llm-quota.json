          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "llm-ledger"
          },
          "queryText": "SELECT\n  (q.ts / $__interval_ms) * $__interval_ms / 1000 AS time,\n  SUM(q.cost_usd) AS \"Spillover cash $\"\nFROM requests q\nJOIN route r USING(request_id)\nWHERE r.desired = 'max'\n  AND q.backend = 'vertex'\n  AND q.ts >= $__from\n  AND q.ts < $__to\nGROUP BY 1\nORDER BY time",
          "queryType": "time series",
          "rawQueryText": "SELECT\n  (q.ts / $__interval_ms) * $__interval_ms / 1000 AS time,\n  SUM(q.cost_usd) AS \"Spillover cash $\"\nFROM requests q\nJOIN route r USING(request_id)\nWHERE r.desired = 'max'\n  AND q.backend = 'vertex'\n  AND q.ts >= $__from\n  AND q.ts < $__to\nGROUP BY 1\nORDER BY time",
          "refId": "A",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "title": "Max to Vertex Spillover cash $ (Vertex/Enterprise)",
