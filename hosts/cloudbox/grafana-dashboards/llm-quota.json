        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "llm-ledger"
          },
          "queryText": "SELECT\n  h0 AS headroom,\n  burn_h AS burn_h,\n  zero_h AS zero_h,\n  vertex_usd AS vertex_usd,\n  k AS k,\n  next_refill_ts / 1000 AS next_refill_time,\n  next_refill_amt AS next_refill_amt,\n  (strftime('%s','now')*1000 - ts)/1000 AS age_s\nFROM quota_watch_runs\nORDER BY ts DESC\nLIMIT 1",
          "queryType": "table",
          "rawQueryText": "SELECT\n  h0 AS headroom,\n  burn_h AS burn_h,\n  zero_h AS zero_h,\n  vertex_usd AS vertex_usd,\n  k AS k,\n  next_refill_ts / 1000 AS next_refill_time,\n  next_refill_amt AS next_refill_amt,\n  (strftime('%s','now')*1000 - ts)/1000 AS age_s\nFROM quota_watch_runs\nORDER BY ts DESC\nLIMIT 1",
          "refId": "A",
          "timeColumns": [
            "next_refill_time"
          ]
        }
      ],
