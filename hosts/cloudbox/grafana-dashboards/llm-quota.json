      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "llm-ledger"
          },
          "queryText": "SELECT\n  ts / 1000 AS time,\n  CASE verdict WHEN 'ample' THEN 0 WHEN 'tight' THEN 1 WHEN 'dry' THEN 2 END AS \"Verdict\"\nFROM quota_watch_runs\nWHERE ts >= $__from AND ts < $__to\n  AND verdict IS NOT NULL\nORDER BY ts",
          "queryType": "time series",
          "rawQueryText": "SELECT\n  ts / 1000 AS time,\n  CASE verdict WHEN 'ample' THEN 0 WHEN 'tight' THEN 1 WHEN 'dry' THEN 2 END AS \"Verdict\"\nFROM quota_watch_runs\nWHERE ts >= $__from AND ts < $__to\n  AND verdict IS NOT NULL\nORDER BY ts",
          "refId": "A",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "title": "Coordinator quota verdict",
      "type": "state-timeline"
    },
