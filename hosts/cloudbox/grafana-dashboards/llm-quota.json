      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "llm-ledger"
          },
          "queryText": "SELECT\n  account,\n  host,\n  SUM(cost_usd) AS \"Max $ (notional)\",\n  SUM(n) AS requests,\n  ROUND(SUM(input * 4.0 + output * 20.0 + cache_read * 0.2 + cache_write_5m * 5.0 + cache_write_1h * 8.0) / 1000000.0, 2) AS \"List-price units\"\nFROM fleet_account_hourly\nWHERE hour >= $__from AND hour < $__to\nGROUP BY account, host\nORDER BY \"Max $ (notional)\" DESC",
          "queryType": "table",
          "rawQueryText": "SELECT\n  account,\n  host,\n  SUM(cost_usd) AS \"Max $ (notional)\",\n  SUM(n) AS requests,\n  ROUND(SUM(input * 4.0 + output * 20.0 + cache_read * 0.2 + cache_write_5m * 5.0 + cache_write_1h * 8.0) / 1000000.0, 2) AS \"List-price units\"\nFROM fleet_account_hourly\nWHERE hour >= $__from AND hour < $__to\nGROUP BY account, host\nORDER BY \"Max $ (notional)\" DESC",
          "refId": "A",
          "timeColumns": []
        }
      ],
