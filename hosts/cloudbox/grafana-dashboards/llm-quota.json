      "targets": [
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "llm-ledger"
          },
          "queryText": "SELECT\n  (ts / $__interval_ms) * $__interval_ms / 1000 AS time,\n  'Headroom H0' AS series,\n  AVG(h0) AS headroom\nFROM quota_watch_runs\nWHERE ts >= $__from AND ts < $__to\nGROUP BY 1\nORDER BY time",
          "queryType": "time series",
          "rawQueryText": "SELECT\n  (ts / $__interval_ms) * $__interval_ms / 1000 AS time,\n  'Headroom H0' AS series,\n  AVG(h0) AS headroom\nFROM quota_watch_runs\nWHERE ts >= $__from AND ts < $__to\nGROUP BY 1\nORDER BY time",
          "refId": "A",
          "timeColumns": [
            "time"
          ]
        },
        {
          "datasource": {
            "type": "frser-sqlite-datasource",
            "uid": "llm-ledger"
          },
          "queryText": "SELECT\n  (ts / $__interval_ms) * $__interval_ms / 1000 AS time,\n  'Forecast' AS series,\n  AVG(headroom) AS headroom\nFROM quota_forecast\nWHERE ts >= $__from AND ts < $__to\nGROUP BY 1\nORDER BY time",
          "queryType": "time series",
          "rawQueryText": "SELECT\n  (ts / $__interval_ms) * $__interval_ms / 1000 AS time,\n  'Forecast' AS series,\n  AVG(headroom) AS headroom\nFROM quota_forecast\nWHERE ts >= $__from AND ts < $__to\nGROUP BY 1\nORDER BY time",
          "refId": "B",
          "timeColumns": [
            "time"
          ]
        }
      ],
      "title": "Headroom & 24h Forecast",
