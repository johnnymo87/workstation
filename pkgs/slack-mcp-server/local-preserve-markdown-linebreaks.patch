+package handler
+
+import (
+	"testing"
+
+	"github.com/slack-go/slack"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	slackGoUtil "github.com/takara2314/slack-go-util"
+)
+
+// Regression tests for the slack-go-util v0.4.3 bump in
+// local-preserve-markdown-linebreaks.patch. In v0.4.0, soft and hard line
+// breaks inside a paragraph were dropped with no separator, gluing a trailing
+// signature line ("…before Tuesday.\n--Claude") onto the previous sentence
+// ("…before Tuesday.--Claude").
+func TestUnitConvertMarkdownPreservesLineBreaks(t *testing.T) {
+	t.Run("paragraph soft line break before signature", func(t *testing.T) {
+		blocks, err := slackGoUtil.ConvertMarkdownTextToBlocks(
+			"nothing here needs you before Tuesday.\n--Claude",
+		)
+		require.NoError(t, err)
+		require.Len(t, blocks, 1)
+		sec, ok := blocks[0].(*slack.SectionBlock)
+		require.True(t, ok, "expected SectionBlock, got %T", blocks[0])
+		assert.Equal(t, slack.MarkdownType, sec.Text.Type)
+		assert.Equal(t, "nothing here needs you before Tuesday.\n--Claude", sec.Text.Text)
+	})
+
+	t.Run("paragraph hard line breaks", func(t *testing.T) {
+		blocks, err := slackGoUtil.ConvertMarkdownTextToBlocks(
+			"line one  \nline two\\\nline three",
+		)
+		require.NoError(t, err)
+		require.Len(t, blocks, 1)
+		sec, ok := blocks[0].(*slack.SectionBlock)
+		require.True(t, ok, "expected SectionBlock, got %T", blocks[0])
+		assert.Equal(t, "line one\nline two\nline three", sec.Text.Text)
+	})
+
+	t.Run("markdown formatting preserved alongside line break", func(t *testing.T) {
+		blocks, err := slackGoUtil.ConvertMarkdownTextToBlocks(
+			"**Bold** and *italic* and [a link](https://example.com) and `code`.\n--Claude",
+		)
+		require.NoError(t, err)
+		require.Len(t, blocks, 1)
+		sec, ok := blocks[0].(*slack.SectionBlock)
+		require.True(t, ok, "expected SectionBlock, got %T", blocks[0])
+		assert.Equal(t, "*Bold* and _italic_ and <https://example.com|a link> and `code`.\n--Claude", sec.Text.Text)
+	})
+
+	t.Run("bullet list followed by blank line and signature", func(t *testing.T) {
+		blocks, err := slackGoUtil.ConvertMarkdownTextToBlocks(
+			"- item one\n- item two\n\n--Claude",
+		)
+		require.NoError(t, err)
+		require.Len(t, blocks, 2)
+		_, ok := blocks[0].(*slack.RichTextBlock)
+		require.True(t, ok, "expected RichTextBlock for list, got %T", blocks[0])
+		sec, ok := blocks[1].(*slack.SectionBlock)
+		require.True(t, ok, "expected SectionBlock for signature, got %T", blocks[1])
+		assert.Equal(t, "--Claude", sec.Text.Text)
+	})
+
+	t.Run("multi-paragraph blockquote", func(t *testing.T) {
+		blocks, err := slackGoUtil.ConvertMarkdownTextToBlocks(
+			"> first\n>\n> second",
+		)
+		require.NoError(t, err)
+		require.Len(t, blocks, 1)
+		rt, ok := blocks[0].(*slack.RichTextBlock)
+		require.True(t, ok, "expected RichTextBlock, got %T", blocks[0])
+		require.Len(t, rt.Elements, 1)
+		quote, ok := rt.Elements[0].(*slack.RichTextQuote)
+		require.True(t, ok, "expected RichTextQuote, got %T", rt.Elements[0])
+		require.Len(t, quote.Elements, 1)
+		txt, ok := quote.Elements[0].(*slack.RichTextSectionTextElement)
+		require.True(t, ok, "expected RichTextSectionTextElement, got %T", quote.Elements[0])
+		assert.Equal(t, "first\n\nsecond", txt.Text)
+	})
+}
