+func TestUnitAssertSlackDownloadHost(t *testing.T) {
+	allowed := []string{
+		"https://files.slack.com/files-pri/T123-F123/foo.png",
+		"https://files.slack.com/files-tmb/T123-F123/foo_360.png",
+		"https://slack.com/files-pri/T123-F123/foo.png",
+		"https://FILES.SLACK.COM/files-pri/T123-F123/foo.png",
+	}
+	for _, u := range allowed {
+		if err := assertSlackDownloadHost(u); err != nil {
+			t.Errorf("expected %q to be allowed, got %v", u, err)
+		}
+	}
+
+	rejected := map[string]string{
+		"off-slack host":     "https://evil.example/files-pri/T123-F123/foo.png",
+		"suffix confusion":   "https://notslack.com/files-pri/foo.png",
+		"label boundary":     "https://slack.com.evil.example/files-pri/foo.png",
+		"userinfo trick":     "https://files.slack.com@evil.example/files-pri/foo.png",
+		"plaintext":          "http://files.slack.com/files-pri/foo.png",
+		"non-http scheme":    "file:///etc/passwd",
+		"unparseable":        "https://exa mple.com/\x7f",
+	}
+	for name, u := range rejected {
+		if err := assertSlackDownloadHost(u); err == nil {
+			t.Errorf("%s: expected %q to be rejected, got nil error", name, u)
+		}
+	}
+}
