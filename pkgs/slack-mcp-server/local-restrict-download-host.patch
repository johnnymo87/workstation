+// assertSlackDownloadHost rejects any attachment download URL that does not
+// point at Slack.
+//
+// This matters because the URL is not ours: it comes back verbatim in the
+// url_private / url_private_download field of files.info, and slack-go's
+// downloadFile attaches "Authorization: Bearer <token>" to whatever URL it is
+// handed, with no host check of its own. A file whose url_private points off
+// Slack therefore turns a download into a credential disclosure to that host —
+// and for a user (xoxp) token, that credential is the human.
+//
+// The trigger is cheap for an attacker: naming a file ID is exactly the kind of
+// instruction that arrives inside untrusted Slack content, which the read-only
+// server variant exists to consume.
+//
+// Checked on Hostname() rather than Host so that a userinfo trick
+// (https://files.slack.com@evil.example/...) is evaluated as evil.example.
+// The leading dot in the suffix keeps the match on a label boundary, so
+// "notslack.com" does not pass.
+func assertSlackDownloadHost(rawURL string) error {
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return fmt.Errorf("attachment download URL is unparseable: %w", err)
+	}
+	if u.Scheme != "https" {
+		return fmt.Errorf("refusing to send credentials over %q to fetch an attachment", u.Scheme)
+	}
+	host := strings.ToLower(u.Hostname())
+	if host != "slack.com" && !strings.HasSuffix(host, ".slack.com") {
+		return fmt.Errorf("refusing to send credentials to non-Slack attachment host %q", host)
+	}
+	return nil
+}
