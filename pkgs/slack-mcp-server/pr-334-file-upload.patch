+// setEnvUpload sets an env var and returns a cleanup func restoring the old value.
+func setEnvUpload(t *testing.T, key, value string) {
+	t.Helper()
+	old, had := os.LookupEnv(key)
+	require.NoError(t, os.Setenv(key, value))
+	t.Cleanup(func() {
+		if had {
+			_ = os.Setenv(key, old)
+		} else {
+			_ = os.Unsetenv(key)
+		}
+	})
+}
